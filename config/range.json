{
    "package_name": "SkyDive",               
    "world": "Pier-Harbor",                            
    "main_agent": "robot",                               
    "ticks_per_sec": 20,
    "frames_per_sec": 20,                        
    "agents":[                                          
        {                                               
            "agent_name": "robot",                       
            "agent_type": null,     
            "sensors": [
                {
                    "sensor_type": "DynamicsSensor",
                    "socket": "IMUSocket",
                    "configuration": {
                        "UseCOM": true,
                        "UseRPY": false
                    },
                    "location" : [0,0,0],
                    "rotation" : [0,0,0]
                },
                {
                    "sensor_name": "RPYDynamicsSensor",
                    "sensor_type": "DynamicsSensor",
                    "socket": "IMUSocket",
                    "configuration": {
                        "UseCOM": false,
                        "UseRPY": true
                    },
                    "location" : [0,0,0],
                    "rotation" : [0,0,0]
                },
                 {
                    "sensor_name": "DenoiseIMUSensor",
                    "sensor_type": "IMUSensor",
                    "socket": "IMUSocket",
                    "configuration" : {},
                    "location" : [0,0,0],
                    "rotation" : [0,0,0]
                },
                {
                    "sensor_name": "NoiseIMUSensor",
                    "sensor_type": "IMUSensor",
                    "socket": "IMUSocket",
                    "configuration": {
                        "AccelSigma": 10,
                        "AngVelSigma": 10,
                        "ReturnBias": true
                    },
                    "location" : [0,0,0],
                    "rotation" : [0,0,0]
                },
                {
                    "sensor_name": "CameraView",
                    "sensor_type": "RGBCamera",
                    "socket": "Viewport",
                    "configuration" : {
                        "CaptureWidth" : 1280,
                        "CaptureHeight" : 720
                    },
                    "location" : [0,0,0],
                    "rotation" : [0,0,0]
                },
                {
                        "sensor_type": "ProfilingSonar",
                        "socket": "SonarSocket",
                        "Hz": 20,
                        "configuration": {
                            "Azimuth": 120,
                            "Elevation": 1,
                            "RangeMin": 1,
                            "RangeMax": 10,
                            "RangeBins": 10,
                            "AzimuthBins": 10,
                            "AddSigma": 0.15,
                            "MultSigma": 0.2,
                            "MultiPath": true,
                            "ClusterSize": 5,
                            "ScaleNoise": true,
                            "AzimuthStreaks": -1,
                            "RangeSigma": 0.1,
                            "ShowWarning": true,
                            "InitOctreeRange": 10,
                            "ViewRegion": true,
                            "ViewOctree": -10
                        }
                },
                {
                        "sensor_type": "RangeFinderSensor",
                        "socket": "IMUSocket",
                        "configuration": {
                            "LaserMaxDistance": 10,
                            "LaserCount": 10,
                            "LaserAngle": 0,
                            "LaserDebug": true
                        }
                    }
            ],
            "dynamics" : {
                "batch_size" : null
            },  
            "control_abstraction": null,
            "location": null,
            "rotation": null
        }
    ]
}